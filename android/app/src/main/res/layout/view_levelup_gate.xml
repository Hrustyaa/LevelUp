<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F10"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:id="@+id/gate_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/gate_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <!-- 1. LevelUp branding -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/gate_logo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/levelup_mark" />

                <TextView
                    android:id="@+id/gate_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.14"
                    android:text="LEVELUP"
                    android:textColor="#F7F8F8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Focus Mode pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_gate_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_gate_dot" />

                <TextView
                    android:id="@+id/gate_focus_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.08"
                    android:text="FOCUS MODE"
                    android:textColor="#C7FA5B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Lock icon -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_gate_lock_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_levelup_lock" />
            </FrameLayout>

            <!-- 4. Headline -->
            <TextView
                android:id="@+id/gate_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Stay focused."
                android:textColor="#F7F8F8"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- 5. Blocked app name -->
            <TextView
                android:id="@+id/gate_target_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gate_badge"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Instagram"
                android:textColor="#F7F8F8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 6 & 7. Exercise challenge info + explanation card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_gate_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    android:id="@+id/gate_challenge_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Exercise Challenge · 5 reps"
                    android:textColor="#F7F8F8"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gate_challenge_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Earn 5 minutes of access by completing 5 verified reps."
                    android:textColor="#B0B8BA"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 8. Primary Start Challenge button -->
            <Button
                android:id="@+id/gate_start_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_gate_primary_btn"
                android:stateListAnimator="@null"
                android:text="Start Challenge"
                android:textAllCaps="false"
                android:textColor="#0A0F10"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 9. Secondary Go Back action -->
            <Button
                android:id="@+id/gate_back_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gate_secondary_btn"
                android:stateListAnimator="@null"
                android:text="Go Back"
                android:textAllCaps="false"
                android:textColor="#F7F8F8"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
