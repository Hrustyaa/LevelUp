# ------------------------------------------------------------------------------
# LevelUp — Root .gitignore
# ------------------------------------------------------------------------------

# macOS System Files & Caches
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Miscellaneous Caches & Logs
*.class
*.log
*.pyc
*.swp
*.bak
*.tmp
.history
.svn/
.atom/
.build/
.buildlog/
.swiftpm/
migrate_working_dir/

# IDE & Editor Configuration
.idea/
*.iml
*.ipr
*.iws
.vscode/
.widget_preview/

# Flutter / Dart / Pub Caches & Output
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Android Build Outputs & Caches
android/.gradle/
android/.kotlin/
*.apk
*.aab
android/captures/
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/
.cxx/

# Local Machine Configuration & Personal Paths
local.properties
android/local.properties
*.local
.env*

# Secrets, Keystores & Signing Credentials
*.keystore
*.jks
*.p12
*.key
*.pem
key.properties
secrets.json

# Crash Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Explicit Whitelist (Do NOT Exclude)
# ------------------------------------------------------------------------------
!/lib/
!/android/app/src/
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/gradlew
!/android/gradlew.bat
!/pubspec.yaml
!/pubspec.lock
!/README.md
!/docs/
!/assets/
!/test/
